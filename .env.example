# =============================================================================
# Environment template — copy to `.env` for local runs (never commit real secrets)
# =============================================================================

# Required: OpenWeatherMap API key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=replace-me

# Optional OpenWeather settings
# OPENWEATHER_TIMEOUT_MS=10000
# DEFAULT_LOCATION=London

# HTTP server
# PORT=3000
# HOST=0.0.0.0
# BIND_ADDRESS=0.0.0.0

# Server socket timeouts (ms) — mitigate slowloris / stalled clients
# HEADERS_TIMEOUT_MS=15000
# REQUEST_TIMEOUT_MS=30000
# KEEP_ALIVE_TIMEOUT_MS=5000

# In-app fixed-window rate limit (per client IP). 0 disables.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# Optional shared secret for GET /weather.
# When set, clients must send either:
#   Authorization: Bearer <token>
#   X-API-Key: <token>
# Leave empty for local DAST / ZAP open scans.
# WEATHER_API_TOKEN=

# Optional TLS (both paths required together; min TLS 1.2)
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem

# Runtime mode
# NODE_ENV=development
