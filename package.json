{
  "name": "quick-test-example",
  "version": "1.0.0",
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node app.js",
    "start": "node app.js",
    "test": "cross-env NODE_ENV=test OPENWEATHER_API_KEY=test-api-token mocha --reporter mocha-sonarqube-reporter --reporter-options output=xunit.xml test --exit",
    "cover": "cross-env NODE_ENV=test OPENWEATHER_API_KEY=test-api-token NODE_OPTIONS=--experimental-vm-modules c8 --reporter=text --reporter=lcov --reporter=html mocha --reporter mocha-sonarqube-reporter --reporter-options output=xunit.xml --exit",
    "licenses": "node scripts/check-licenses.js",
    "precover": "rimraf coverage xunit.xml",
    "postcover": "node scripts/coverage-makeover.js"
  },
  "author": "Nova Ferrydianto <novaferrydianto@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "fast-check": "^4.9.0",
    "mocha": "^12.0.3",
    "mocha-sonarqube-reporter": "1.0.2",
    "mochawesome": "^8.0.1",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "snyk-to-html": "^3.7.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "command-line-args": "^6.0.2",
    "handlebars": "^4.7.10"
  },
  "c8": {
    "all": true,
    "include": [
      "*.js",
      "src/**/*.js",
      "scripts/check-licenses.js"
    ],
    "exclude": [
      "test/**",
      "node_modules/**",
      "coverage/**"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "report-dir": "coverage",
    "all-files": true,
    "check-coverage": true,
    "lines": 70,
    "functions": 70,
    "branches": 75,
    "statements": 70
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "10.2.6",
    "serialize-javascript": "7.1.3",
    "uuid": "11.1.1",
    "js-yaml": "5.4.1",
    "qs": "6.16.0",
    "mocha": {
      "diff": "8.0.4",
      "js-yaml": "5.4.1"
    }
  }
}
