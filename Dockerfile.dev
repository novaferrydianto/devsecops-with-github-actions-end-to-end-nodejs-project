# Official Node.js image: node:26-alpine
FROM node@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66

WORKDIR /app

# Upgrade OS packages to mitigate vulnerabilities
RUN apk upgrade --no-cache

# Copy package files first
COPY package*.json ./

# Install all dependencies including dev deps (pinned by hash in lockfile)
RUN npm ci --ignore-scripts

# Copy source code
COPY . .

# Create non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
USER nodejs

EXPOSE 3000

CMD ["./node_modules/.bin/nodemon", "--legacy-watch", "app.js"]
