FROM node:26-alpine@sha256:144769ec3f32e8ee36b3cfde91e82bee25d9367b20f31a151f3f7eea3a2a8541

WORKDIR /app

# Upgrade OS packages to mitigate vulnerabilities
RUN apk upgrade --no-cache

# Copy package files first
COPY package*.json ./

# Install all dependencies including dev deps (pinned by hash in lockfile)
RUN npm ci

# Copy source code
COPY . .

EXPOSE 3000

CMD ["npx", "nodemon", "--legacy-watch", "app.js"]
