FROM node:26-alpine@sha256:e88a35be04478413b7c71c455cd9865de9b9360e1f43456be5951032d7ac1a66

WORKDIR /app

# Upgrade OS packages to mitigate vulnerabilities
RUN apk upgrade --no-cache

# Copy package files first
COPY package*.json ./

# Install all dependencies including dev deps (pinned by hash in lockfile)
RUN npm ci

# Copy source code
COPY . .

EXPOSE 3000

CMD ["npx", "nodemon", "--legacy-watch", "app.js"]
