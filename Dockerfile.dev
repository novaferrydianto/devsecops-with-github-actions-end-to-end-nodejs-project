# Official Node.js image: node:26-alpine
FROM node@sha256:e961046fec20896e8904f2b4a8b4c7e5ca91826d84d8d33d83dbaa61f942069e

WORKDIR /app

# Upgrade OS packages to mitigate vulnerabilities
RUN apk upgrade --no-cache

# Copy package files first
COPY package*.json ./

# Install all dependencies including dev deps (pinned by hash in lockfile)
RUN npm ci --ignore-scripts

# Copy only the app source needed to run the dev server (no tests, docs,
# CI config, or other repo content that isn't needed at runtime -- avoids
# relying on .dockerignore alone to keep unrelated/sensitive files out).
COPY app.js fetch-weather.js prepared-for-the-weather.js ./

# Create non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
USER nodejs

EXPOSE 3000

CMD ["./node_modules/.bin/nodemon", "--legacy-watch", "app.js"]
